{
  "name": "@jobcopilot/agent-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./adapters/openai-compatible": {
      "types": "./dist/adapters/openai-compatible/index.d.ts",
      "default": "./dist/adapters/openai-compatible/index.js"
    },
    "./adapters/minimax": {
      "types": "./dist/adapters/minimax/index.d.ts",
      "default": "./dist/adapters/minimax/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@jobcopilot/agent-protocol": "workspace:*",
    "@jobcopilot/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^3.1.4"
  }
}
