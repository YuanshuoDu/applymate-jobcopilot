# Production Worker configuration. Do not commit a populated .env file.
DATABASE_URL="postgresql://..."
REDIS_URL="rediss://..."
AGENT_WEB_URL="https://your-web-app.example"

# These values must exactly match the Web deployment.
AGENT_WORKER_SECRET=""
AGENT_AUTOMATION_CRON_SECRET=""
# HMAC secret for the Web admin control endpoint. Required for every public
# listener, including Fly's HTTPS proxy route.
WORKER_CONTROL_SECRET=""
# Keep loopback for local/private hosts. apps/worker/fly.toml sets 0.0.0.0 so
# Fly's HTTPS proxy can reach port 3001; the HMAC secret remains mandatory.
WORKER_ADMIN_HOST="127.0.0.1"

# Start conservatively to respect ATS rate limits.
CLOAK_MAX_WORKERS="1"
AGENT_SCHEDULER_INTERVAL_MS="300000"

# Optional integrations.
CAPSOLVER_API_KEY=""
ENABLE_BULL_BOARD="0"
BULL_BOARD_PORT="3001"
BULL_BOARD_PASSWORD=""
