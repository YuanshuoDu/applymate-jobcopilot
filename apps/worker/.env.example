# Production Worker configuration. Do not commit a populated .env file.
DATABASE_URL="postgresql://..."
# Shared credential envelope decryption. Production uses the same AWS KMS key
# identity as Web; local/test uses a 32-byte CREDENTIAL_ENCRYPTION_KEY.
CREDENTIAL_KMS_KEY_ID=""
CREDENTIAL_ENCRYPTION_KEY=""
AWS_REGION=""
# Upstash TLS Redis protocol URL shared with the Web app. BullMQ cannot use
# UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN directly.
REDIS_URL="rediss://default:<password>@<endpoint>:6379"
AGENT_WEB_URL="https://your-web-app.example"

# These values must exactly match the Web deployment.
AGENT_WORKER_SECRET=""
AGENT_AUTOMATION_CRON_SECRET=""
# Shared with Web for five-minute broadcast delivery and alert evaluation.
WEB_MAINTENANCE_CRON_SECRET=""
AUDIT_CHECKPOINT_CRON_SECRET=""
# HMAC secret for the Web admin control endpoint. Required for every
# non-loopback listener, including Fly's HTTPS proxy route.
WORKER_CONTROL_SECRET=""
# Keep this explicit loopback value for local-only use. Any non-loopback
# address, including private hosts, needs WORKER_CONTROL_SECRET.
WORKER_ADMIN_HOST="127.0.0.1"

# Start conservatively to respect ATS rate limits.
CLOAK_MAX_WORKERS="1"
AGENT_SCHEDULER_INTERVAL_MS="300000"

# Optional integrations.
CAPSOLVER_API_KEY=""
ENABLE_BULL_BOARD="0"
BULL_BOARD_PORT="3001"
BULL_BOARD_PASSWORD=""
