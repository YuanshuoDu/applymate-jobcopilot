# ──────────────────────────────────────────────────────────────
# ApplyMate AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Supabase:  postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Neon:      postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
# Local:     postgresql://postgres:postgres@localhost:5432/applymate
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/applymate"
# Optional direct Neon URL used only by Prisma migrations. Keep DATABASE_URL
# pooled for serverless runtime traffic when the Neon pooler is available.
DIRECT_DATABASE_URL=""

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"

# Production auth base URL (no trailing slash). Leave this unset for local
# development so Auth.js derives the active localhost port from the request.
NEXTAUTH_URL=""

# Canonical administrator origin used for production routing and readiness checks.
ADMIN_APP_URL=""

# WebAuthn administrator MFA. Set both explicitly in production so reverse
# proxies cannot change the relying-party origin or domain used for ceremonies.
WEBAUTHN_ORIGIN=""
WEBAUTHN_RP_ID=""
WEBAUTHN_RP_NAME="ApplyMate"

# Candidate RLS rollout. Keep off until the candidate role and policies have
# been applied in the controlled PostgreSQL deployment session.
RLS_RUNTIME_MODE="off"
RLS_CANDIDATE_ROLE="applymate_candidate"

# Bootstrap the first database-backed super administrator after the account
# exists. Run `pnpm --filter web exec ts-node --project prisma/tsconfig.seed.json
# prisma/seed-admin-roles.ts` once per non-production environment. Production
# memberships, roles, MFA and session revocation are managed in /admin/access.
INITIAL_SUPER_ADMIN_EMAIL=""

# ── OAuth providers ─────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Transactional email (password reset) ────────────────────
# Resend: https://resend.com/api-keys
RESEND_API_KEY=""
# A verified Resend sender, e.g. "ApplyMate <no-reply@yourdomain.com>"
EMAIL_FROM=""
# Optional unit cost used by the API Usage center; leave 0 for a free/unknown plan.
EXTERNAL_API_COST_PER_REQUEST_RESEND="0"

# ── AI providers ────────────────────────────────────────────
# Platform default model used when a user has no provider key.
MINIMAX_API_KEY=""
OPENAI_API_KEY=""

# Application-layer credential encryption. Production requires an Azure Key Vault
# Standard vault with an RSA key. The local key is only for development/test.
AZURE_KEY_VAULT_URL=""
AZURE_KEY_NAME="applymate-credential-key"
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""
# Server-only Azure Monitor and Cost Management scope for the usage dashboard.
# The identity needs Monitoring Reader on this vault and Cost Management Reader
# on AZURE_COST_MANAGEMENT_SCOPE (usually the subscription).
AZURE_KEY_VAULT_RESOURCE_ID=""
AZURE_SUBSCRIPTION_ID=""
AZURE_COST_MANAGEMENT_SCOPE=""
AZURE_COST_CURRENCY="USD"
AZURE_COST_ALERT_CURRENCY="USD"
AZURE_COST_ALERT_USD="5"
AZURE_MAX_BUDGET_USD=""
AZURE_USAGE_CACHE_TTL_SECONDS="900"
AZURE_COST_CACHE_TTL_SECONDS="86400"
EXTERNAL_API_COST_PER_REQUEST_AZURE_KEY_VAULT="0"
ANTHROPIC_API_KEY=""

# ── Adzuna Job Search API ────────────────────────────────────
# Register at https://developer.adzuna.com/ (free, no credit card)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ── CleanJobData normalized discovery feed ───────────────────
# Platform-owned server key from https://cleanjobdata.com/dashboard#plan
# Never expose this value through NEXT_PUBLIC_* or user API-key responses.
CLEANJOBDATA_API_KEY=""

# ── Unattended auto-apply ───────────────────────────────────
# Web and Worker must use the same Redis endpoint and both shared secrets.
# For Upstash/BullMQ use the TLS Redis protocol URL from the console, e.g.
# rediss://default:<password>@<endpoint>:6379. Do not use the REST URL/token
# pair here; BullMQ requires the Redis protocol endpoint.
REDIS_URL="rediss://default:<password>@<endpoint>:6379"
# Server-only read-only REST credentials for the Upstash usage snapshot.
PAID_REDIS_KV_REST_API_URL=""
PAID_REDIS_KV_REST_API_TOKEN=""
# Optional Upstash Developer API credentials for current-month requests,
# bandwidth, and billed cost. Keep these server-only (never NEXT_PUBLIC_*).
PAID_REDIS_DATABASE_ID=""
UPSTASH_API_EMAIL=""
UPSTASH_API_KEY=""
REDIS_COST_PER_100K_COMMANDS="0.20"
REDIS_COST_ALERT_USD="5"
REDIS_MAX_BUDGET_USD="20"
# INFO fallback cache (server-only); set fallback to 0 when management stats are configured.
REDIS_INFO_CACHE_TTL_SECONDS="900"
REDIS_INFO_FALLBACK_ENABLED="1"
# Server-only Neon Admin API credentials for the Other APIs usage snapshot.
# NEON_ORG_ID enables current-month consumption metrics on paid usage-based plans.
# NEON_PROJECT_ID scopes the request and enables the all-plan project-details fallback.
NEON_API_KEY=""
NEON_ORG_ID=""
NEON_PROJECT_ID=""
NEON_PLAN=""
NEON_COST_ALERT_USD="5"
NEON_USAGE_CACHE_TTL_SECONDS="900"
# Optional overrides; leave blank to use the documented Launch/Scale rates.
# Agent/Business/Enterprise plans need overrides when their rates are not
# represented by the built-in Launch/Scale model.
NEON_COST_PER_CU_HOUR=""
NEON_COST_PER_GB_MONTH=""
NEON_COST_PER_INSTANT_RESTORE_GB_MONTH=""
NEON_COST_PER_PUBLIC_NETWORK_GB=""
NEON_COST_PER_PRIVATE_NETWORK_GB=""
NEON_COST_PER_EXTRA_BRANCH_MONTH=""
NEON_COST_PER_SNAPSHOT_GB_MONTH=""
NEON_PUBLIC_NETWORK_INCLUDED_GB=""
CRON_SECRET=""
AGENT_AUTOMATION_CRON_SECRET=""
# Shared with the Worker for five-minute broadcast delivery and alert evaluation.
WEB_MAINTENANCE_CRON_SECRET=""
AUDIT_CHECKPOINT_CRON_SECRET=""
AGENT_WORKER_SECRET=""
# HMAC-protected Web -> Worker admin control base URL, without
# /internal/admin/control. For Fly use https://applymate-worker.fly.dev.
# Both values must be set for queue controls to work; the secret must exactly
# match the Worker value.
WORKER_CONTROL_URL=""
WORKER_CONTROL_SECRET=""

# ── Worker queue cost controls ───────────────────────────────────────
# BullMQ's maximum effective idle wait is 10 seconds. These values reduce
# Redis command churn while preserving stalled-job recovery and can be set on
# the worker deployment (not necessarily the web deployment).
BULLMQ_DRAIN_DELAY_SECONDS="10"
BULLMQ_STALLED_INTERVAL_MS="120000"
AGENT_SCHEDULER_INTERVAL_MS="900000"
