// Prisma Schema �?ApplyMate AI
// Database: PostgreSQL (Supabase / Neon / self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// NextAuth v5 adapter tables
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Core domain models
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // hashed, for credential login
  plan          Plan      @default(free)
  phone         String?
  location      String?
  linkedin      String?
  github        String?
  preferences   Json?     // { targetRoles, targetLocations, salaryExpectation, workAuthorization, openToRelocation, aiSettings }
  personaFields Json?     // PersonaField[] �?learned answers from form fills
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // M1 extensions
  onboardedAt        DateTime?
  onboardingGoals    String[]
  defaultTemplateId  String?
  defaultAccentColor String?
  defaultFontFamily  String?
  aiAutoPilot        String   @default("off")

  accounts       Account[]
  sessions       Session[]
  jobs           Job[]
  resumes        Resume[]
  activities     Activity[]
  agentConfig        AgentConfig?
  agentRoles         AgentRole[]
  customAgentRoles   CustomAgentRole[]
  agentRunQuestions  AgentRunQuestion[]
  agentRuns          AgentRun[]
  agentExecutions    AgentExecution[]
  agentSessions      AgentSession[]
  applicationTasks  ApplicationTask[]
  agentAutomations   AgentAutomation[]
  resumeVersions ResumeVersion[]
  directions     Direction[]
  coverLetters   CoverLetter[]
  notifications  Notification[]
  apiKeys        UserApiKeys?
  personaFacts   PersonaFact[]
  personaEvidenceChunks PersonaEvidenceChunk[]
  gmailSyncState GmailSyncState?
  gmailMessages  GmailMessage[]
  gmailRecommendations GmailRecommendation[]
}

enum Plan {
  free
  pro
  enterprise
}

enum BillingInterval {
  forever
  month
  year
}

model PlanCatalogue {
  id          String          @id @default(cuid())
  plan        Plan            @unique
  name        String
  priceMinor  Int             @default(0)
  currency    String          @default("EUR")
  interval    BillingInterval @default(month)
  description String          @db.Text
  features    Json
  badge       String?
  cta         String
  trialDays   Int             @default(0)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active, sortOrder])
  @@map("plan_catalogue")
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  company     String
  logo        String?   // 2-letter abbreviation or image URL
  role        String
  location    String?
  status      JobStatus @default(saved)
  score       Int?      // AI match score 0-100
  url         String?   @db.Text
  description String?   @db.Text
  salary      String?
  source      String?   // linkedin | indeed | manual | agent
  notes        String?   @db.Text
  coverLetter  String?   @db.Text  // saved by Writer agent (deprecated — use CoverLetter table)
  analysisNote String?   @db.Text  // saved by Analyst agent (recommendation)
  keywords     String?   @db.Text  // ATS keywords extracted from JD during scoring
  appliedAt    DateTime?
  followUpAt  DateTime?
  workflowState JobWorkflowState @default(draft)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // M1 extensions
  finalResumeId      String?
  finalCoverLetterId String?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applyResults     ApplyResult[]
  applicationTasks ApplicationTask[]
  activities       Activity[]
  finalResume      Resume?       @relation("JobFinalResume",   fields: [finalResumeId],      references: [id], onDelete: SetNull)
  finalCoverLetter CoverLetter?  @relation("JobFinalCL",       fields: [finalCoverLetterId], references: [id], onDelete: SetNull)
  adaptedResumes   Resume[]      @relation("JobAdaptedResumes")
  coverLetters     CoverLetter[]
  gmailMessages    GmailMessage[]
  savedRecommendations GmailRecommendation[] @relation("SavedGmailRecommendations")

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

// Durable control-plane record for one candidate/job application.  Job keeps
// the candidate-facing lifecycle; this model owns resumable agent execution.
model ApplicationTask {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  sessionId       String?
  status          String   @default("discovered")
  checkpoint      String?
  question        Json?
  sensitiveFlags  Json?
  // Answers the candidate explicitly supplied for this application only.
  // Never inferred from a model or promoted into the shared Persona automatically.
  confirmedAnswers Json?
  resumeId        String?
  coverLetterId   String?
  workerTaskId    String?
  error           String?  @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job      Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session  AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  events   ApplicationTaskEvent[]

  @@unique([userId, jobId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([sessionId, status])
  @@map("application_tasks")
}

model ApplicationTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  actor     String
  body      String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  task ApplicationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("application_task_events")
}

enum JobStatus {
  saved
  applied
  interview
  offer
  rejected
}

// Internal preparation state. This is deliberately separate from the
// candidate-facing lifecycle in JobStatus.
enum JobWorkflowState {
  draft
  ready_to_apply
  queued
  submitting
  submitted
}

model Resume {
  id              String   @id @default(cuid())
  userId          String
  name            String
  content         Json     // ResumeContent JSON (see types.ts)
  templateId      String?
  templateOptions Json?    // TemplateOptions JSON { accentColor, fontFamily, density }
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // M1 extensions
  directionId    String?
  kind           String   @default("base")
  parentResumeId String?
  targetJobId    String?
  origin         String   @default("manual")
  basicsDetached Boolean  @default(false)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  direction    Direction?      @relation(fields: [directionId], references: [id], onDelete: SetNull)
  parent       Resume?         @relation("ResumeLineage", fields: [parentResumeId], references: [id], onDelete: SetNull)
  derivatives  Resume[]        @relation("ResumeLineage")
  targetJob    Job?            @relation("JobAdaptedResumes", fields: [targetJobId], references: [id], onDelete: SetNull)
  coverLetters CoverLetter[]
  finalForJobs Job[]           @relation("JobFinalResume")

  @@index([userId])
  @@index([userId, directionId])
  @@index([targetJobId])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  userId    String
  content   Json     // ResumeContent snapshot
  name      String   // resume name at time of snapshot
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Persona Knowledge Base — confirmed, auditable candidate facts
// ─────────────────────────────────────────────

model PersonaFact {
  id              String   @id @default(cuid())
  userId          String
  key             String
  category        String
  value           String   @db.Text
  normalizedValue String   @map("normalized_value")
  source          String   // manual | form_scan | resume | ai_derived
  sourceRef       String?  @map("source_ref")
  evidence        Json?    // { label, applicationUrl?, resumeId?, excerpt? }
  confidence      Float    @default(1)
  status          String   @default("confirmed") // pending | confirmed | superseded | rejected | revoked
  allowedUses     String[] @default(["form_fill", "tailor", "cover_letter"])
  consentAt       DateTime? @map("consent_at")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceChunks PersonaEvidenceChunk[]

  @@unique([userId, key, normalizedValue])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, category, status])
  @@map("persona_facts")
}

model PersonaEvidenceChunk {
  id                String   @id @default(cuid())
  userId            String
  factId            String?  @map("fact_id")
  sourceType        String   @map("source_type") // resume | persona_fact
  sourceRef         String   @map("source_ref")
  content           String   @db.Text
  contentHash       String   @map("content_hash")
  status            String   @default("confirmed")
  allowedUses       String[] @default(["form_fill", "tailor", "cover_letter"])
  embeddingModel    String?  @map("embedding_model")
  embeddedAt        DateTime? @map("embedded_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fact PersonaFact? @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef, contentHash])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, sourceType, status])
  @@map("persona_evidence_chunks")
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  type      ActivityType
  text      String
  color     String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

model UserApiKeys {
  id           String   @id @default(cuid())
  userId       String   @unique
  adzunaAppId  String?
  adzunaAppKey String?
  rapidapiKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_api_keys")
}

enum ActivityType {
  applied
  interview_scheduled
  offer_received
  rejected
  email_sent
  agent_action
  resume_tailored
  status_changed
  note_added
}

model AgentConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  isRunning         Boolean  @default(false)
  dailyLimit        Int      @default(10)
  minMatchScore     Int      @default(75)
  autoApply         Boolean  @default(false)
  requireApproval   Boolean  @default(true)
  targetLocations   String[]
  targetRoles       String[]
  excludeCompanies  String[]
  priorityCompanies String[]
  autoCoverLetter   Boolean  @default(false)
  coverTone         String   @default("professional")
  useTailoredCV     Boolean  @default(false)
  salaryMin         Int      @default(0)
  salaryMax         Int      @default(0)
  notifyApply       Boolean  @default(true)
  notifyReject      Boolean  @default(true)
  weeklySummary     Boolean  @default(false)
  followUpReminder  Boolean  @default(true)
  followUpDays      Int      @default(7)
  model             String   @default("claude-sonnet-4-6")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Agent Role Configs (one per role per user)
// ─────────────────────────────────────────────

enum AgentRoleType {
  scout
  analyst
  writer
  reviewer
  executor
  auditor
}

model AgentRole {
  id           String        @id @default(cuid())
  userId       String
  role         AgentRoleType
  enabled      Boolean       @default(true)
  provider     String        @default("anthropic")
  model        String
  apiKey       String?
  systemPrompt String?       @db.Text  // user-customizable instructions
  lastRunAt    DateTime?
  lastResult   Json?         // { count, durationMs, summary }
  totalRuns    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AtsEmployer {
  id        Int      @id @default(autoincrement())
  atsType   String
  slug      String
  name      String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt
  jobCount  Int      @default(0)

  @@unique([atsType, slug])
  @@map("ats_employers")
}

model ApplyResult {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  jobId      String   @map("job_id")
  status     String                     // submitted | manual | failed | dry-run
  mode       String                     // unattended | assisted
  atsType    String?  @map("ats_type")
  flowUsed   String?  @map("flow_used")
  error      String?
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("apply_results")
}

model FormPattern {
  id            String   @id @default(cuid())
  atsHost       String   @map("ats_host")       // "jobs.lever.co"
  urlPattern    String   @map("url_pattern")    // "spotify/" for matching
  fieldMapping  Json     @map("field_mapping")  // {"input[name='first_name']": "firstName", ...}
  successCount  Int      @default(1) @map("success_count")
  failureCount  Int      @default(0) @map("failure_count")
  lastSuccessAt DateTime @default(now()) @map("last_success_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([atsHost, urlPattern])
  @@map("form_patterns")
}

model AiBudget {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  month     String                                // "2026-06"
  used      Int      @default(0)
  limit     Int      @default(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month])
  @@map("ai_budgets")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  jobId     String?  @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gmail application evidence and recommendation inbox
// ─────────────────────────────────────────────────────────────────────────────

model GmailSyncState {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastError    String?  @db.Text @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

enum GmailMessageKind {
  application_received
  interview_invitation
  offer
  rejection
  application_update
  recommendation_digest
  other
}

model GmailMessage {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  gmailMessageId  String           @map("gmail_message_id")
  gmailThreadId   String?          @map("gmail_thread_id")
  kind            GmailMessageKind
  senderEmail     String?          @map("sender_email")
  senderName      String?          @map("sender_name")
  subject         String
  excerpt         String?          @db.Text
  inferredCompany String?          @map("inferred_company")
  inferredRole    String?          @map("inferred_role")
  receivedAt      DateTime         @map("received_at")
  scheduledAt     DateTime?        @map("scheduled_at")
  jobId           String?          @map("job_id")
  matchConfidence Float?           @map("match_confidence")
  manuallyLinked  Boolean          @default(false) @map("manually_linked")
  processedAt     DateTime?        @map("processed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recommendations GmailRecommendation[]

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt(sort: Desc)])
  @@index([userId, kind, scheduledAt])
  @@index([userId, jobId, receivedAt(sort: Desc)])
  @@map("gmail_messages")
}

enum GmailRecommendationStatus {
  pending
  saved
  dismissed
}

model GmailRecommendation {
  id              String                    @id @default(cuid())
  userId          String                    @map("user_id")
  sourceMessageId String                    @map("source_message_id")
  platform        String?
  company         String?
  role            String?
  location        String?
  salary          String?
  url             String?                   @db.Text
  description     String?                   @db.Text
  fingerprint     String
  status          GmailRecommendationStatus @default(pending)
  savedJobId      String?                   @map("saved_job_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage GmailMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  savedJob      Job?         @relation("SavedGmailRecommendations", fields: [savedJobId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("gmail_recommendations")
}

// ─────────────────────────────────────────────
// Agent Run Questions (pause/resume queue)
// ─────────────────────────────────────────────

model AgentRunQuestion {
  id          String    @id @default(cuid())
  userId      String
  runId       String
  stage       String
  question    String    @db.Text
  options     Json
  answer      String?
  autonomous  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  answeredAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runId])
  @@index([userId, runId, answeredAt])
}

model AgentRun {
  id              String   @id @default(cuid())
  userId          String
  status          String
  durationMs      Int
  stagesCompleted Int      @default(0)
  jobsFound       Int      @default(0)
  report          Json?
  log             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("agent_runs")
}

// Durable control plane for a multi-stage Agent run.  Unlike AgentRun (the
// historical summary), this row owns cancellation, retries and the exact
// stage snapshot required to resume after a worker or web-process restart.
model AgentExecution {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String   @unique
  status         String   @default("queued") // queued | running | waiting_for_user | paused | completed | failed | cancelled
  checkpoint     String   @default("scout")
  state          Json?
  error          String?  @db.Text
  workerTaskId   String?
  attemptCount   Int      @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("agent_executions")
}

model AgentSession {
  id            String    @id @default(cuid())
  userId        String
  goal          String    @db.Text
  status        String
  source        String
  memorySummary String    @default("") @db.Text
  qualityScore  Float?
  currentTaskId String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      SubAgentTask[]
  transcript AgentTranscriptEvent[]
  approvals  AgentApproval[]
  applicationTasks ApplicationTask[]
  execution AgentExecution?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("agent_sessions")
}

model SubAgentTask {
  id                   String   @id @default(cuid())
  sessionId            String
  role                 String
  taskType             String
  status               String
  goal                 String   @db.Text
  constraints          Json
  successCriteria      Json
  allowedActions       Json
  context              Json
  expectedOutputSchema Json
  result               Json?
  confidence           Float?
  failureReason        String?  @db.Text
  qualityGateResult    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([sessionId, role])
  @@map("sub_agent_tasks")
}

model AgentTranscriptEvent {
  id         String   @id @default(cuid())
  sessionId  String
  taskId     String?
  type       String
  speaker    String
  title      String?
  body       String   @db.Text
  data       Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, type])
  @@map("agent_transcript_events")
}

model AgentApproval {
  id        String    @id @default(cuid())
  sessionId String
  taskId    String?
  userId    String
  type      String
  status    String    @default("pending")
  title     String
  body      String    @db.Text
  impact    Json?
  payload   Json
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([sessionId, status])
  @@map("agent_approvals")
}

model AgentAutomation {
  id              String    @id @default(cuid())
  userId          String
  name            String
  enabled         Boolean   @default(true)
  triggerType     String
  cron            String?
  timezone        String    @default("Europe/Berlin")
  targetRoles     String[]
  targetLocations String[]
  minScore        Int       @default(85)
  dailyCap        Int       @default(8)
  requireApproval Boolean   @default(true)
  autoApply       Boolean   @default(false)
  createdBy       String    @default("user")
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, createdAt])
  @@index([userId, nextRunAt])
  @@map("agent_automations")
}

// ─────────────────────────────────────────────
// Custom Agent Roles (user-defined pipeline nodes)
// ─────────────────────────────────────────────

model CustomAgentRole {
  id           String   @id @default(cuid())
  userId       String
  name         String
  icon         String   @default("🧩")
  description  String?
  systemPrompt String?  @db.Text
  provider     String   @default("anthropic")
  model        String   @default("claude-haiku-4-5-20251001")
  insertAfter  String   @default("auditor")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// M1: Direction + CoverLetter models
// ─────────────────────────────────────────────

model Direction {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes Resume[]

  @@unique([userId, name])
  @@index([userId])
}

model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  resumeId        String?
  content         String   @db.Text
  tone            String   @default("professional")
  templateId      String?
  templateOptions Json?
  origin          String   @default("manual")
  isFinal         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  finalForJobs Job[] @relation("JobFinalCL")

  @@index([userId, jobId])
  @@index([jobId, isFinal])
}
