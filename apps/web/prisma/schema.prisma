// Prisma Schema �?ApplyMate AI
// Database: PostgreSQL (Supabase / Neon / self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// NextAuth v5 adapter tables
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  refreshTokenEnc   String? @db.Text
  access_token      String? @db.Text
  accessTokenEnc    String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  idTokenEnc        String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Core domain models
// ─────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  password         String? // hashed, for credential login
  plan             Plan              @default(free)
  accountStatus    UserAccountStatus @default(active)
  authVersion      Int               @default(1)
  suspendedAt      DateTime?
  suspendedById    String?
  suspensionReason String?
  phone            String?
  location         String?
  linkedin         String?
  github           String?
  preferences      Json? // { targetRoles, targetLocations, salaryExpectation, workAuthorization, openToRelocation, aiSettings }
  personaFields    Json? // PersonaField[] �?learned answers from form fills
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // M1 extensions
  onboardedAt        DateTime?
  onboardingGoals    String[]
  defaultTemplateId  String?
  defaultAccentColor String?
  defaultFontFamily  String?
  aiAutoPilot        String    @default("off")

  accounts                    Account[]
  sessions                    Session[]
  jobs                        Job[]
  resumes                     Resume[]
  activities                  Activity[]
  agentConfig                 AgentConfig?
  agentRoles                  AgentRole[]
  customAgentRoles            CustomAgentRole[]
  agentRunQuestions           AgentRunQuestion[]
  agentRuns                   AgentRun[]
  agentExecutions             AgentExecution[]
  agentSessions               AgentSession[]
  agentApprovals              AgentApproval[]
  agentActionReservations     AgentActionReservation[]
  agentTurns                  AgentTurn[]
  agentInputs                 AgentInput[]
  applicationTasks            ApplicationTask[]
  formPatterns                FormPattern[]
  agentAutomations            AgentAutomation[]
  resumeVersions              ResumeVersion[]
  directions                  Direction[]
  coverLetters                CoverLetter[]
  notifications               Notification[]
  apiKeys                     UserApiKeys?
  personaFacts                PersonaFact[]
  personaEvidenceChunks       PersonaEvidenceChunk[]
  gmailSyncState              GmailSyncState?
  gmailMessages               GmailMessage[]
  gmailRecommendations        GmailRecommendation[]
  adminMembership             AdminMembership?             @relation("AdminUser")
  adminNotifications          AdminNotification[]          @relation("AdminNotificationRecipient")
  broadcastDeliveries         AdminBroadcastDelivery[]
  aiUsageEvents               AiUsageEvent[]               @relation("AiUsageUser")
  harnessMetricEvents         HarnessMetricEvent[]         @relation("HarnessMetricEventUser")
  usageEvents                 UsageEvent[]                 @relation("UsageEventUser")
  jobApiUsageEvents           JobApiUsageEvent[]           @relation("JobApiUsageUser")
  externalApiUsageEvents      ExternalApiUsageEvent[]      @relation("ExternalApiUsageUser")
  discoveryOptimizationEvents DiscoveryOptimizationEvent[] @relation("DiscoveryOptimizationUser")
  adminWebAuthnCredentials    AdminWebAuthnCredential[]
  adminWebAuthnChallenges     AdminWebAuthnChallenge[]
  adminReauthGrants           AdminReauthGrant[]
  supportCases                SupportCase[]                @relation("SupportRequester")
  planChanges                 UserPlanChange[]
  planSubscription            UserPlanSubscription?
  featureOverrides            UserFeatureOverride[]
  adminAccessReviewsGiven     AdminAccessReview[]          @relation("AccessReviewReviewer")
  deletionRequest             AdminDataDeletionRequest?
  deletionRequestsProcessed   AdminDataDeletionRequest[]   @relation("DeletionProcessor")
}

enum Plan {
  free
  pro
  enterprise
}

enum UserAccountStatus {
  active
  suspended
}

model UserPlanChange {
  id          String   @id @default(cuid())
  userId      String
  fromPlan    Plan
  toPlan      Plan
  reason      String
  actorUserId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_plan_changes")
}

enum PlanSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

model UserPlanSubscription {
  id                      String                 @id @default(cuid())
  userId                  String                 @unique @map("user_id")
  plan                    Plan
  status                  PlanSubscriptionStatus @default(active)
  trialStartsAt           DateTime?              @map("trial_starts_at")
  trialEndsAt             DateTime?              @map("trial_ends_at")
  currentPeriodStart      DateTime?              @map("current_period_start")
  currentPeriodEnd        DateTime?              @map("current_period_end")
  cancelAtPeriodEnd       Boolean                @default(false) @map("cancel_at_period_end")
  scheduledPlan           Plan?                  @map("scheduled_plan")
  scheduledAt             DateTime?              @map("scheduled_at")
  version                 Int                    @default(1)
  providerCustomerRef     String?                @map("provider_customer_ref")
  providerSubscriptionRef String?                @map("provider_subscription_ref")
  updatedById             String?                @map("updated_by_id")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@index([scheduledAt])
  @@map("user_plan_subscriptions")
}

model UserFeatureOverride {
  id          String    @id @default(cuid())
  userId      String
  featureKey  String
  enabled     Boolean
  limit       Int?
  reason      String
  actorUserId String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId, expiresAt])
  @@map("user_feature_overrides")
}

enum BillingInterval {
  forever
  month
  year
}

model PlanCatalogue {
  id              String           @id @default(cuid())
  plan            Plan             @unique
  name            String
  priceMinor      Int              @default(0)
  currency        String           @default("EUR")
  interval        BillingInterval  @default(month)
  description     String           @db.Text
  features        Json
  entitlements Json
  badge           String?
  cta             String
  trialDays       Int              @default(0)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fromTransitions PlanTransition[] @relation("FromPlan")
  toTransitions   PlanTransition[] @relation("ToPlan")

  @@index([active, sortOrder])
  @@map("plan_catalogue")
}

model Job {
  id            String           @id @default(cuid())
  userId        String
  company       String
  logo          String? // 2-letter abbreviation or image URL
  role          String
  location      String?
  status        JobStatus        @default(saved)
  score         Int? // AI match score 0-100
  url           String?          @db.Text
  description   String?          @db.Text
  salary        String?
  source        String? // linkedin | indeed | manual | agent
  notes         String?          @db.Text
  coverLetter   String?          @db.Text // saved by Writer agent (deprecated — use CoverLetter table)
  analysisNote  String?          @db.Text // saved by Analyst agent (recommendation)
  keywords      String?          @db.Text // ATS keywords extracted from JD during scoring
  appliedAt     DateTime?
  followUpAt    DateTime?
  workflowState JobWorkflowState @default(draft)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // M1 extensions
  finalResumeId      String?
  finalCoverLetterId String?

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applyResults         ApplyResult[]
  applicationTasks     ApplicationTask[]
  activities           Activity[]
  finalResume          Resume?               @relation("JobFinalResume", fields: [finalResumeId], references: [id], onDelete: SetNull)
  finalCoverLetter     CoverLetter?          @relation("JobFinalCL", fields: [finalCoverLetterId], references: [id], onDelete: SetNull)
  adaptedResumes       Resume[]              @relation("JobAdaptedResumes")
  coverLetters         CoverLetter[]
  gmailMessages        GmailMessage[]
  savedRecommendations GmailRecommendation[] @relation("SavedGmailRecommendations")

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

// Durable control-plane record for one candidate/job application.  Job keeps
// the candidate-facing lifecycle; this model owns resumable agent execution.
model ApplicationTask {
  id               String    @id @default(cuid())
  userId           String
  jobId            String
  sessionId        String?
  status           String    @default("discovered")
  checkpoint       String?
  question         Json?
  sensitiveFlags   Json?
  // Answers the candidate explicitly supplied for this application only.
  // Never inferred from a model or promoted into the shared Persona automatically.
  confirmedAnswers Json?
  resumeId         String?
  coverLetterId    String?
  workerTaskId     String?
  error            String?   @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session AgentSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  events  ApplicationTaskEvent[]

  @@unique([userId, jobId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([sessionId, status])
  @@map("application_tasks")
}

model ApplicationTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  actor     String
  body      String   @db.Text
  data      Json?
  createdAt DateTime @default(now())

  task ApplicationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("application_task_events")
}

enum JobStatus {
  saved
  applied
  interview
  offer
  rejected
}

// Internal preparation state. This is deliberately separate from the
// candidate-facing lifecycle in JobStatus.
enum JobWorkflowState {
  draft
  ready_to_apply
  queued
  submitting
  submitted
}

enum AgentArtifactLifecycle {
  base
  draft
}

enum SubmissionAttemptState {
  reserved
  submitted
  failed
}

// Durable source of truth for recruitment artifacts consumed by the Worker.
// The Worker uses pg SQL; Web owns this Prisma schema and its migrations.
model AgentArtifact {
  id             String                 @id
  userId         String
  jobId          String
  artifactType   String
  lifecycle      AgentArtifactLifecycle
  baseId         String?
  baseHash       String?
  content        Json
  hash           String
  constraintHash String
  provenanceRefs String[]               @default([])
  evidenceRefs   String[]               @default([])
  previousHash   String?
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, jobId, lifecycle, artifactType])
  @@index([userId, jobId, lifecycle])
  @@map("agent_artifact")
}

// Durable idempotency ledger for the single external application-submit path.
// The Worker owns execution through pg.Pool; Web owns this Prisma schema.
model SubmissionAttempt {
  id             String                 @id @default(cuid())
  userId         String
  jobId          String
  receiptId      String                 @unique
  constraintHash String
  artifactHash   String
  state          SubmissionAttemptState
  responseRef    String?
  errorCode      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, jobId, state])
  @@map("submission_attempt")
}

model Resume {
  id              String   @id @default(cuid())
  userId          String
  name            String
  content         Json // ResumeContent JSON (see types.ts)
  templateId      String?
  templateOptions Json? // TemplateOptions JSON { accentColor, fontFamily, density }
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // M1 extensions
  directionId    String?
  kind           String  @default("base")
  parentResumeId String?
  targetJobId    String?
  origin         String  @default("manual")
  basicsDetached Boolean @default(false)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  direction    Direction?      @relation(fields: [directionId], references: [id], onDelete: SetNull)
  parent       Resume?         @relation("ResumeLineage", fields: [parentResumeId], references: [id], onDelete: SetNull)
  derivatives  Resume[]        @relation("ResumeLineage")
  targetJob    Job?            @relation("JobAdaptedResumes", fields: [targetJobId], references: [id], onDelete: SetNull)
  coverLetters CoverLetter[]
  finalForJobs Job[]           @relation("JobFinalResume")

  @@index([userId])
  @@index([userId, directionId])
  @@index([targetJobId])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  userId    String
  content   Json // ResumeContent snapshot
  name      String // resume name at time of snapshot
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Persona Knowledge Base — confirmed, auditable candidate facts
// ─────────────────────────────────────────────

model PersonaFact {
  id              String    @id @default(cuid())
  userId          String
  key             String
  category        String
  value           String    @db.Text
  normalizedValue String    @map("normalized_value")
  source          String // manual | form_scan | resume | ai_derived
  sourceRef       String?   @map("source_ref")
  evidence        Json? // { label, applicationUrl?, resumeId?, excerpt? }
  confidence      Float     @default(1)
  status          String    @default("confirmed") // pending | confirmed | superseded | rejected | revoked
  allowedUses     String[]  @default(["form_fill", "tailor", "cover_letter"])
  consentAt       DateTime? @map("consent_at")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceChunks PersonaEvidenceChunk[]

  @@unique([userId, key, normalizedValue])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, category, status])
  @@map("persona_facts")
}

model PersonaEvidenceChunk {
  id             String    @id @default(cuid())
  userId         String
  factId         String?   @map("fact_id")
  sourceType     String    @map("source_type") // resume | persona_fact
  sourceRef      String    @map("source_ref")
  content        String    @db.Text
  contentHash    String    @map("content_hash")
  status         String    @default("confirmed")
  allowedUses    String[]  @default(["form_fill", "tailor", "cover_letter"])
  embeddingModel String?   @map("embedding_model")
  embeddedAt     DateTime? @map("embedded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fact PersonaFact? @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef, contentHash])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, sourceType, status])
  @@map("persona_evidence_chunks")
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  jobId     String?
  type      ActivityType
  text      String
  color     String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

model UserApiKeys {
  id              String   @id @default(cuid())
  userId          String   @unique
  adzunaAppId     String?
  adzunaAppIdEnc  String?  @db.Text
  adzunaAppKey    String?
  adzunaAppKeyEnc String?  @db.Text
  rapidapiKey     String?
  rapidapiKeyEnc  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_api_keys")
}

enum ActivityType {
  applied
  interview_scheduled
  offer_received
  rejected
  email_sent
  agent_action
  resume_tailored
  status_changed
  note_added
}

model AgentConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  isRunning         Boolean  @default(false)
  dailyLimit        Int      @default(10)
  minMatchScore     Int      @default(75)
  autoApply         Boolean  @default(false)
  requireApproval   Boolean  @default(true)
  targetLocations   String[]
  targetRoles       String[]
  excludeCompanies  String[]
  priorityCompanies String[]
  autoCoverLetter   Boolean  @default(false)
  coverTone         String   @default("professional")
  useTailoredCV     Boolean  @default(false)
  salaryMin         Int      @default(0)
  salaryMax         Int      @default(0)
  notifyApply       Boolean  @default(true)
  notifyReject      Boolean  @default(true)
  weeklySummary     Boolean  @default(false)
  followUpReminder  Boolean  @default(true)
  followUpDays      Int      @default(7)
  model             String   @default("claude-sonnet-4-6")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Agent Role Configs (one per role per user)
// ─────────────────────────────────────────────

enum AgentRoleType {
  scout
  analyst
  writer
  reviewer
  executor
  auditor
}

model AgentRole {
  id           String        @id @default(cuid())
  userId       String
  role         AgentRoleType
  enabled      Boolean       @default(true)
  provider     String        @default("anthropic")
  model        String
  apiKey       String?
  systemPrompt String?       @db.Text // user-customizable instructions
  lastRunAt    DateTime?
  lastResult   Json? // { count, durationMs, summary }
  totalRuns    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AtsEmployer {
  id        Int       @id @default(autoincrement())
  atsType   String
  slug      String
  name      String?
  country   String?   @db.VarChar(2)
  enabled   Boolean   @default(true)
  version   Int       @default(1)
  firstSeen DateTime?
  lastSeen  DateTime?
  jobCount  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([atsType, slug])
  @@index([atsType, enabled])
  @@map("ats_employers")
}

model ApplyResult {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  jobId      String   @map("job_id")
  status     String // submitted | manual | failed | dry-run
  mode       String // unattended | assisted
  atsType    String?  @map("ats_type")
  flowUsed   String?  @map("flow_used")
  error      String?
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("apply_results")
}

model FormPattern {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  atsHost       String   @map("ats_host") // "jobs.lever.co"
  urlPattern    String   @map("url_pattern") // "spotify/" for matching
  fieldMapping  Json     @map("field_mapping") // {"input[name='first_name']": "firstName", ...}
  successCount  Int      @default(1) @map("success_count")
  failureCount  Int      @default(0) @map("failure_count")
  lastSuccessAt DateTime @default(now()) @map("last_success_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, atsHost, urlPattern])
  @@map("form_patterns")
}

model AiBudget {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  month         String // "2026-06"
  used          Int                    @default(0)
  limit         Int                    @default(30)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  adjustments   AiBudgetAdjustment[]
  resetRequests AiBudgetResetRequest[]

  @@unique([userId, month])
  @@map("ai_budgets")
}

model AiBudgetAdjustment {
  id             String   @id @default(cuid())
  budgetId       String   @map("budget_id")
  actorUserId    String   @map("actor_user_id")
  kind           String
  previousLimit  Int      @map("previous_limit")
  nextLimit      Int      @map("next_limit")
  previousUsed   Int?     @map("previous_used")
  nextUsed       Int?     @map("next_used")
  reason         String
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")
  budget         AiBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  @@index([budgetId, createdAt(sort: Desc)])
  @@map("ai_budget_adjustments")
}

enum AiBudgetResetStatus {
  pending
  approved
  expired
  cancelled
}

model AiBudgetResetRequest {
  id                    String              @id @default(cuid())
  budgetId              String              @map("budget_id")
  requesterId           String              @map("requester_id")
  approverId            String?             @map("approver_id")
  reason                String
  status                AiBudgetResetStatus @default(pending)
  budgetVersion         Int                 @map("budget_version")
  createIdempotencyKey  String              @unique @map("create_idempotency_key")
  approveIdempotencyKey String?             @unique @map("approve_idempotency_key")
  expiresAt             DateTime            @map("expires_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  approvedAt            DateTime?           @map("approved_at")
  budget                AiBudget            @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("ai_budget_reset_requests")
}

model AiProviderConfig {
  id                   String          @id @default(cuid())
  key                  String          @unique
  displayName          String
  apiBase              String
  secretRef            String?
  credentialConfigured Boolean         @default(false)
  enabled              Boolean         @default(true)
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  models               AiModelConfig[]

  @@map("ai_provider_configs")
}

model AiModelConfig {
  id          String           @id @default(cuid())
  providerId  String
  model       String
  label       String
  description String?
  tier        String
  priceIn     Float            @default(0)
  priceOut    Float            @default(0)
  contextK    Int              @default(128)
  active      Boolean          @default(true)
  provider    AiProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
  @@index([providerId, active])
  @@map("ai_model_configs")
}

model AiRouteConfig {
  id               String   @id @default(cuid())
  featureKey       String   @unique
  defaultProvider  String
  defaultModel     String
  fallbackProvider String?
  fallbackModel    String?
  version          Int      @default(1)
  updatedById      String
  updatedAt        DateTime @updatedAt

  @@map("ai_route_configs")
}

enum AdminMembershipStatus {
  active
  suspended
  revoked
}

enum AdminMfaLevel {
  none
  totp
  webauthn
}

enum AdminWebAuthnChallengePurpose {
  registration
  reauthentication
}

