// Append-only Harness 2.0 telemetry. The Worker writes this table with raw
// pg.Pool; Web owns the schema and the admin read models.
model HarnessMetricEvent {
  id                String   @id @default(cuid())
  eventType         String   @map("event_type")
  schemaVersion     String   @default("harness-event.v1") @map("schema_version")
  correlationId     String   @map("correlation_id")
  traceId           String   @map("trace_id")
  spanId            String   @map("span_id")
  parentSpanId      String?  @map("parent_span_id")
  userId            String?  @map("user_id")
  sessionId         String   @map("session_id")
  turnId            String?  @map("turn_id")
  taskId            String?  @map("task_id")
  itemId            String?  @map("item_id")
  toolCallId        String?  @map("tool_call_id")
  applicationTaskId String?  @map("application_task_id")
  jobId             String?  @map("job_id")
  automationId      String?  @map("automation_id")
  queueJobId        String?  @map("queue_job_id")
  toolName          String?  @map("tool_name")
  provider          String?
  model             String?
  source            String   @default("unknown")
  environment       String   @default("unknown")
  idempotencyKey    String   @map("idempotency_key")
  status            String?
  errorCode         String?  @map("error_code")
  value             Float?
  durationMs        Int?     @map("duration_ms")
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  costMicros        Int      @default(0) @map("cost_micros")
  estimatedCostUsd  Float    @default(0) @map("estimated_cost_usd")
  payload           Json     @default("{}")
  occurredAt        DateTime @default(now()) @map("occurred_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation("HarnessMetricEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([traceId, idempotencyKey])
  @@index([traceId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([userId, model, toolName, occurredAt])
  @@map("harness_metric_events")
}

// Five-minute usage rollups. aggregationKey is deterministic and prevents a
// scheduler retry from double-counting the same bucket.
model UsageEvent {
  id               String   @id @default(cuid())
  aggregationKey   String   @unique @map("aggregation_key")
  userId           String?  @map("user_id")
  sessionId        String?  @map("session_id")
  turnId           String?  @map("turn_id")
  toolName         String?  @map("tool_name")
  provider         String?
  model            String
  eventType        String   @map("event_type")
  bucketStart      DateTime @map("bucket_start")
  day              DateTime @db.Date
  eventCount       Int      @default(0) @map("event_count")
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  costMicros       Int      @default(0) @map("cost_micros")
  estimatedCostUsd Float    @default(0) @map("estimated_cost_usd")
  totalLatencyMs   Int      @default(0) @map("total_latency_ms")
  lastOccurredAt   DateTime @map("last_occurred_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User? @relation("UsageEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, model, toolName, day])
  @@index([bucketStart, model])
  @@index([sessionId, turnId, toolName, bucketStart])
  @@map("usage_event")
}

// Durable SLO breach facts. Alerts are kept separate from AdminAlertEvent so
// Harness telemetry remains provider-neutral and can be emitted by the Worker.
model HarnessSloAlert {
  id         String    @id @default(cuid())
  ruleKey    String    @map("rule_key")
  metric     String
  value      Float
  threshold  Float
  traceId    String?   @map("trace_id")
  status     String    @default("open")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([ruleKey, status, createdAt])
  @@index([metric, createdAt])
  @@map("harness_slo_alerts")
}

// Current server-side rollout decision. One row per environment keeps the
// session-start decision atomic and makes a rollback immediately observable.
model RolloutStage {
  id                    String   @id @default(cuid())
  environment           String   @unique
  stageKey              String   @map("stage_key")
  rolloutPercent        Int      @default(0) @map("rollout_percent")
  enabled               Boolean  @default(true)
  internalUserIds       String[] @default([]) @map("internal_user_ids")
  observationStartedAt  DateTime? @map("observation_started_at")
  observationEndsAt     DateTime? @map("observation_ends_at")
  version               Int      @default(1)
  status                String   @default("active")
  rollbackReason        String?  @map("rollback_reason")
  lastTransitionAt      DateTime @default(now()) @map("last_transition_at")
  createdById           String   @default("system") @map("created_by_id")
  updatedById           String   @default("system") @map("updated_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([environment, status])
  @@index([stageKey, updatedAt])
  @@map("rollout_stage")
}

// Metrics-only V1/V2 comparison facts. Raw model output, candidate content,
// prompts, and external responses are intentionally not representable here.
model RolloutDiff {
  id               String   @id @default(cuid())
  comparisonId     String   @map("comparison_id")
  environment      String
  stageKey         String   @map("stage_key")
  sessionId        String   @map("session_id")
  traceId          String?  @map("trace_id")
  metricKey        String   @map("metric_key")
  legacyValue      Float    @map("legacy_value")
  v2Value          Float    @map("v2_value")
  delta            Float
  withinThreshold  Boolean  @map("within_threshold")
  occurredAt       DateTime @default(now()) @map("occurred_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([comparisonId, metricKey])
  @@index([environment, stageKey, createdAt])
  @@index([sessionId, createdAt])
  @@index([metricKey, createdAt])
  @@map("rollout_diff")
}

model JobApiUsageEvent {
  id                 String    @id @default(cuid())
  userId             String?   @map("user_id")
  provider           String
  operation          String
  credentialSource   String    @default("public") @map("credential_source")
  runtime            String    @default("unknown")
  requestCount       Int       @default(1) @map("request_count")
  jobsReturned       Int       @default(0) @map("jobs_returned")
  latencyMs          Int       @map("latency_ms")
  status             String
  httpStatus         Int?      @map("http_status")
  rateLimitLimit     Int?      @map("rate_limit_limit")
  rateLimitRemaining Int?      @map("rate_limit_remaining")
  rateLimitResetAt   DateTime? @map("rate_limit_reset_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User?     @relation("JobApiUsageUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, status])
  @@index([provider, operation, createdAt])
  @@index([credentialSource, createdAt])
  @@index([userId, createdAt])
  @@index([runtime, createdAt])
  @@map("job_api_usage_events")
}

model ExternalApiUsageEvent {
  id               String   @id @default(cuid())
  userId           String?  @map("user_id")
  provider         String
  operation        String
  credentialSource String   @default("platform") @map("credential_source")
  requestCount     Int      @default(1) @map("request_count")
  inputBytes       Int      @default(0) @map("input_bytes")
  outputBytes      Int      @default(0) @map("output_bytes")
  estimatedCostUsd Float    @default(0) @map("estimated_cost_usd")
  latencyMs        Int      @map("latency_ms")
  status           String
  httpStatus       Int?     @map("http_status")
  errorCode        String?  @map("error_code")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User?    @relation("ExternalApiUsageUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, status])
  @@index([provider, operation, createdAt])
  @@index([credentialSource, createdAt])
  @@index([userId, createdAt])
  @@map("external_api_usage_events")
}

model ApiQuota {
  id           String                @id @default(cuid())
  category     String
  provider     String
  operation    String                @default("*")
  metric       String
  planName     String                @map("plan_name")
  period       String
  limit        Float
  resetDay     Int                   @default(1) @map("reset_day")
  enabled      Boolean               @default(true)
  version      Int                   @default(1)
  updatedById  String?               @map("updated_by_id")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  reservations ApiQuotaReservation[]

  @@unique([category, provider, operation, metric])
  @@index([category, enabled, provider])
  @@map("api_quotas")
}

model ApiQuotaReservation {
  id              String   @id @default(cuid())
  quotaId         String   @map("quota_id")
  provider        String
  operation       String
  metric          String
  credentialScope String   @map("credential_scope")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  requestedUnits  Float    @map("requested_units")
  settledUnits    Float?   @map("settled_units")
  status          String   @default("reserved")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  quota           ApiQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@index([quotaId, periodStart, periodEnd, status])
  @@index([provider, operation, credentialScope, createdAt])
  @@map("api_quota_reservations")
}

model DiscoveryOptimizationEvent {
  id                   String   @id @default(cuid())
  userId               String?  @map("user_id")
  eventType            String   @map("event_type")
  provider             String?
  credentialScope      String   @default("platform") @map("credential_scope")
  requestsAvoided      Int      @default(0) @map("requests_avoided")
  jobsReturned         Int      @default(0) @map("jobs_returned")
  netNewJobs           Int      @default(0) @map("net_new_jobs")
  validApplyUrls       Int      @default(0) @map("valid_apply_urls")
  completeDescriptions Int      @default(0) @map("complete_descriptions")
  latencyMs            Int      @default(0) @map("latency_ms")
  reasonCode           String?  @map("reason_code")
  metadata             Json?
  createdAt            DateTime @default(now()) @map("created_at")
  user                 User?    @relation("DiscoveryOptimizationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([credentialScope, createdAt])
  @@map("discovery_optimization_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gmail application evidence and recommendation inbox
// ─────────────────────────────────────────────────────────────────────────────

model GmailSyncState {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastError    String?   @map("last_error") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

enum GmailMessageKind {
  application_received
  interview_invitation
  offer
  rejection
  application_update
  recommendation_digest
  other
}

model GmailMessage {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  gmailMessageId  String           @map("gmail_message_id")
  gmailThreadId   String?          @map("gmail_thread_id")
  kind            GmailMessageKind
  senderEmail     String?          @map("sender_email")
  senderName      String?          @map("sender_name")
  subject         String
  excerpt         String?          @db.Text
  inferredCompany String?          @map("inferred_company")
  inferredRole    String?          @map("inferred_role")
  receivedAt      DateTime         @map("received_at")
  scheduledAt     DateTime?        @map("scheduled_at")
  jobId           String?          @map("job_id")
  matchConfidence Float?           @map("match_confidence")
  manuallyLinked  Boolean          @default(false) @map("manually_linked")
  processedAt     DateTime?        @map("processed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recommendations GmailRecommendation[]

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt(sort: Desc)])
  @@index([userId, kind, scheduledAt])
  @@index([userId, jobId, receivedAt(sort: Desc)])
  @@map("gmail_messages")
}

enum GmailRecommendationStatus {
  pending
  saved
  dismissed
}

model GmailRecommendation {
  id              String                    @id @default(cuid())
  userId          String                    @map("user_id")
  sourceMessageId String                    @map("source_message_id")
  platform        String?
  company         String?
  role            String?
  location        String?
  salary          String?
  url             String?                   @db.Text
  description     String?                   @db.Text
  fingerprint     String
  status          GmailRecommendationStatus @default(pending)
  savedJobId      String?                   @map("saved_job_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage GmailMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  savedJob      Job?         @relation("SavedGmailRecommendations", fields: [savedJobId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("gmail_recommendations")
}

model PlanTransition {
  id        String   @id @default(cuid())
  fromPlan  Plan
  toPlan    Plan
  enabled   Boolean  @default(true)
  note      String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from PlanCatalogue @relation("FromPlan", fields: [fromPlan], references: [plan], onDelete: Restrict)
  to   PlanCatalogue @relation("ToPlan", fields: [toPlan], references: [plan], onDelete: Restrict)

  @@unique([fromPlan, toPlan])
  @@map("plan_transitions")
}

// ─────────────────────────────────────────────
// Agent Run Questions (pause/resume queue)
// ─────────────────────────────────────────────

model AgentRunQuestion {
  id         String    @id @default(cuid())
  userId     String
  runId      String
  stage      String
  question   String    @db.Text
  options    Json
  answer     String?
  autonomous Boolean   @default(false)
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runId])
  @@index([userId, runId, answeredAt])
}

model AgentRun {
  id              String   @id @default(cuid())
  userId          String
  status          String
  durationMs      Int
  stagesCompleted Int      @default(0)
  jobsFound       Int      @default(0)
  report          Json?
  log             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("agent_runs")
}

// Durable control plane for a multi-stage Agent run.  Unlike AgentRun (the
// historical summary), this row owns cancellation, retries and the exact
// stage snapshot required to resume after a worker or web-process restart.
model AgentExecution {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String    @unique
  status       String    @default("queued") // queued | running | waiting_for_user | paused | completed | failed | cancelled
  checkpoint   String    @default("scout")
  state        Json?
  error        String?   @db.Text
  workerTaskId String?
  attemptCount Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("agent_executions")
}

model AgentSession {
  id            String    @id @default(cuid())
  userId        String
  goal          String    @db.Text
  status        String
  source        String
  memorySummary String    @default("") @db.Text
  qualityScore  Float?
  currentTaskId String?
  lastViewedAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  eventSequence BigInt    @default(0)

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks              SubAgentTask[]
  mailboxMessages    AgentMailboxMessage[]
  transcript         AgentTranscriptEvent[]
  approvals          AgentApproval[]
  actionReservations AgentActionReservation[]
  applicationTasks   ApplicationTask[]
  turns              AgentTurn[]
  steps              AgentStep[]
  contextSnapshots AgentContextSnapshot[]
  inputs             AgentInput[]
  items              AgentItem[]
  events             AgentEvent[]
  execution          AgentExecution?
  automation         AgentAutomation?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, lastViewedAt(sort: Desc)])
  @@index([userId, status])
  @@map("agent_sessions")
}

// Harness 2.0 durable Turn boundary. Active root serialization is enforced
// by the partial unique index in the additive migration, not by a global
// sessionId unique constraint, so terminal history remains append-only.
model AgentTurn {
  id                   String    @id @default(cuid())
  sessionId            String
  userId               String
  status               String    @default("queued")
  source               String
  input                Json
  finalResponse        String?   @db.Text
  error                String?   @db.Text
  rootTaskId           String?
  contextSnapshotId    String?
  modelProfileSnapshot Json
  toolPolicySnapshot   Json
  budgetSnapshot       Json
  revision             Int       @default(0)
  inputTokens          Int       @default(0)
  outputTokens         Int       @default(0)
  estimatedCostUsd     Decimal   @default(0) @db.Decimal(12, 8)
  durationMs           Int?
  startedAt            DateTime?
  completedAt          DateTime?
  leaseOwnerId         String?
  leaseExpiresAt       DateTime?
  leaseStartedAt       DateTime?
  leaseVersion         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  session         AgentSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps           AgentStep[]
  inputs          AgentInput[]          @relation("AgentTurnInputs")
  items           AgentItem[]
  events          AgentEvent[]
  approvals       AgentApproval[]
  subAgentTasks   SubAgentTask[]
  mailboxMessages AgentMailboxMessage[]

  @@index([sessionId, createdAt])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@unique([id, sessionId])
  @@map("agent_turns")
}

model AgentStep {
  id                     String    @id @default(cuid())
  sessionId              String
  turnId                 String
  taskId                 String?
  parentStepId           String?
  ordinal                Int
  attempt                Int       @default(1)
  status                 String    @default("queued")
  inputSnapshotId        String?
  inputThroughSequence   BigInt
  consumedInputIds       Json
  modelProfileSnapshot   Json
  providerResponseId     String?
  providerConversationId String?
  finishReason           String?
  errorCode              String?
  inputTokens            Int       @default(0)
  outputTokens           Int       @default(0)
  estimatedCostUsd       Decimal   @default(0) @db.Decimal(12, 8)
  durationMs             Int?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn           AgentTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  parentStep     AgentStep?   @relation("AgentStepRepairChain", fields: [parentStepId], references: [id], onDelete: SetNull)
  childSteps     AgentStep[]  @relation("AgentStepRepairChain")
  consumedInputs AgentInput[] @relation("AgentStepConsumedInputs")
  items          AgentItem[]

  @@unique([turnId, ordinal, attempt])
  @@index([turnId, status, createdAt])
  @@index([providerResponseId])
  @@map("agent_steps")
}

// Immutable, source-attributed context material used to rebuild a Step after
// a worker restart. The JSON content is checksummed by the Worker; the
// database constraints keep its cursor and accounting columns additive.
model AgentContextSnapshot {
  id               String   @id @default(cuid())
  sessionId        String
  throughSequence  BigInt
  version          Int
  schemaVersion    String   @default("agent-harness.context.v1")
  content          Json
  summary          String   @db.Text
  checksum         String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 8)
  tokenAccounting  Json     @default("{}")
  createdAt        DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@unique([sessionId, throughSequence])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([sessionId, throughSequence])
  @@map("agent_context_snapshots")
}

model AgentInput {
  id               String    @id @default(cuid())
  sessionId        String
  targetTurnId     String?
  userId           String
  clientMessageId  String
  delivery         String
  status           String    @default("accepted")
  content          Json
  acceptedSequence BigInt
  consumedByStepId String?
  consumedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetTurn     AgentTurn?   @relation("AgentTurnInputs", fields: [targetTurnId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedByStep AgentStep?   @relation("AgentStepConsumedInputs", fields: [consumedByStepId], references: [id], onDelete: SetNull)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, status, acceptedSequence])
  @@index([targetTurnId, status, acceptedSequence])
  @@map("agent_inputs")
}

model AgentItem {
  id          String    @id
  sessionId   String
  turnId      String
  stepId      String?
  taskId      String?
  type        String
  status      String
  phase       String?
  revision    Int       @default(0)
  content     Json
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    AgentTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  step    AgentStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  events  AgentEvent[]

  @@index([turnId, stepId, createdAt])
  @@index([sessionId, type, createdAt])
  @@map("agent_items")
}

model AgentEvent {
  id             String   @id @default(cuid())
  sessionId      String
  turnId         String
  itemId         String?
  taskId         String?
  sequence       BigInt
  type           String
  actor          String
  correlationId  String
  causationId    String?
  idempotencyKey String?
  payload        Json
  createdAt      DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn    AgentTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  item    AgentItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@unique([sessionId, idempotencyKey])
  @@index([turnId, sequence])
  @@index([taskId, sequence])
  @@map("agent_events")
}

model AgentOutbox {
  id             String    @id @default(cuid())
  topic          String
  aggregateId    String
  idempotencyKey String    @unique
  payload        Json
  publishedAt    DateTime?
  attemptCount   Int       @default(0)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("agent_outbox")
}

model SubAgentTask {
  id                   String    @id @default(cuid())
  sessionId            String
  turnId               String?
  rootTaskId           String?
  parentTaskId         String?
  path                 String    @default("/")
  depth                Int       @default(0)
  role                 String
  taskType             String
  status               String
  goal                 String    @db.Text
  constraints          Json
  successCriteria      Json
  allowedActions       Json
  context              Json
  expectedOutputSchema Json
  result               Json?
  confidence           Float?
  failureReason        String?   @db.Text
  qualityGateResult    Json?
  contextSnapshotId    String?
  modelProfileSnapshot Json      @default("{}")
  toolPolicySnapshot   Json      @default("{}")
  budgetSnapshot       Json      @default("{}")
  attemptCount         Int       @default(0)
  maxAttempts          Int       @default(1)
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  interruptRequestedAt DateTime?
  closedAt             DateTime?
  outputArtifactIds    Json      @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  session                 AgentSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn                    AgentTurn?            @relation(fields: [turnId, sessionId], references: [id, sessionId], onDelete: Cascade)
  parentTask              SubAgentTask?         @relation("SubAgentTaskTree", fields: [parentTaskId, sessionId], references: [id, sessionId], onDelete: Cascade)
  childTasks              SubAgentTask[]        @relation("SubAgentTaskTree")
  rootTask                SubAgentTask?         @relation("SubAgentTaskRoot", fields: [rootTaskId, sessionId], references: [id, sessionId], onDelete: Cascade)
  rootDescendants         SubAgentTask[]        @relation("SubAgentTaskRoot")
  mailboxMessagesSent     AgentMailboxMessage[] @relation("AgentMailboxFromTask")
  mailboxMessagesReceived AgentMailboxMessage[] @relation("AgentMailboxToTask")

  @@index([sessionId, status])
  @@index([sessionId, role])
  @@index([sessionId, path])
  @@index([sessionId, rootTaskId, path])
  @@index([sessionId, parentTaskId, createdAt])
  @@unique([id, sessionId])
  @@map("sub_agent_tasks")
}

model AgentMailboxMessage {
  id             String    @id @default(cuid())
  sessionId      String
  turnId         String
  fromTaskId     String?
  toTaskId       String?
  kind           String
  payload        Json
  idempotencyKey String
  deliveredAt    DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  session  AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn     AgentTurn     @relation(fields: [turnId, sessionId], references: [id, sessionId], onDelete: Cascade)
  fromTask SubAgentTask? @relation("AgentMailboxFromTask", fields: [fromTaskId, sessionId], references: [id, sessionId], onDelete: Cascade)
  toTask   SubAgentTask? @relation("AgentMailboxToTask", fields: [toTaskId, sessionId], references: [id, sessionId], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([toTaskId, consumedAt, createdAt])
  @@index([sessionId, turnId, consumedAt, createdAt])
  @@map("agent_mailbox_messages")
}

model AgentTranscriptEvent {
  id         String   @id @default(cuid())
  sessionId  String
  taskId     String?
  type       String
  speaker    String
  title      String?
  body       String   @db.Text
  data       Json?
  durationMs Int?
  createdAt  DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, type])
  @@map("agent_transcript_events")
}

model AgentApproval {
  id           String    @id @default(cuid())
  sessionId    String
  taskId       String?
  userId       String
  // Nullable during the additive migration; new receipts always populate it.
  turnId       String?
  toolCallId   String?
  jobId        String?
  type         String
  status       String    @default("pending")
  title        String
  body         String    @db.Text
  impact       Json?
  payload      Json
  resourceHash String?
  materialHash String?
  answersHash  String?
  scopeHash    String?
  nonceHash    String?
  revision     Int       @default(0)
  expiresAt    DateTime?
  decidedAt    DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  session      AgentSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  turn         AgentTurn?               @relation(fields: [turnId], references: [id], onDelete: Cascade)
  reservations AgentActionReservation[]

  @@index([userId, status, createdAt])
  @@index([sessionId, status])
  @@index([userId, status, expiresAt])
  @@index([sessionId, turnId, status])
  @@unique([userId, nonceHash])
  @@map("agent_approvals")
}

// Durable single-use reservation created in the same transaction as receipt
// consumption. The eventual broker/executor owns its state transitions.
model AgentActionReservation {
  id             String   @id @default(cuid())
  approvalId     String
  userId         String
  sessionId      String
  turnId         String
  jobId          String
  toolCallId     String
  action         String
  resourceHash   String
  idempotencyKey String   @unique
  status         String   @default("reserved")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  approval AgentApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  session  AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalId])
  @@index([userId, status, createdAt])
  @@index([sessionId, turnId, status])
  @@map("agent_action_reservations")
}

model AgentAutomation {
  id              String    @id @default(cuid())
  userId          String
  name            String
  enabled         Boolean   @default(true)
  triggerType     String
  cron            String?
  timezone        String    @default("Europe/Berlin")
  targetRoles     String[]
  targetLocations String[]
  minScore        Int       @default(85)
  dailyCap        Int       @default(8)
  requireApproval Boolean   @default(true)
  autoApply       Boolean   @default(false)
  createdBy       String    @default("user")
  sessionId       String?   @unique
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, enabled, createdAt])
  @@index([userId, nextRunAt])
  @@map("agent_automations")
}

// ─────────────────────────────────────────────
// Custom Agent Roles (user-defined pipeline nodes)
// ─────────────────────────────────────────────

model CustomAgentRole {
  id           String   @id @default(cuid())
  userId       String
  name         String
  icon         String   @default("🧩")
  description  String?
  systemPrompt String?  @db.Text
  provider     String   @default("anthropic")
  model        String   @default("claude-haiku-4-5-20251001")
  insertAfter  String   @default("auditor")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// M1: Direction + CoverLetter models
// ─────────────────────────────────────────────

model Direction {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes Resume[]

  @@unique([userId, name])
  @@index([userId])
}

model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  resumeId        String?
  content         String   @db.Text
  tone            String   @default("professional")
  templateId      String?
  templateOptions Json?
  origin          String   @default("manual")
  isFinal         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume       Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  finalForJobs Job[]   @relation("JobFinalCL")

  @@index([userId, jobId])
  @@index([jobId, isFinal])
}
