{
  "framework": "nextjs",
  "buildCommand": "node apps/web/scripts/vercel-build.cjs",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --ignore-scripts",
  "devCommand": "pnpm --filter @jobcopilot/web dev",
  "crons": [
    {
      "path": "/api/gmail/sync/daily",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/notifications/daily",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/admin/audit-checkpoint",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/observability/alerts/evaluate",
      "schedule": "*/5 * * * *"
    }
  ]
}
