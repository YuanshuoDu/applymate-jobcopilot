{
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @jobcopilot/shared build && pnpm --filter @jobcopilot/web exec prisma generate && pnpm --filter @jobcopilot/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --ignore-scripts",
  "devCommand": "pnpm --filter @jobcopilot/web dev",
  "crons": [
    {
      "path": "/api/gmail/sync/daily",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/notifications/daily",
      "schedule": "30 8 * * *"
    }
  ]
}
